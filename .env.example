# -----------------------------------------------------------------------------
# Sainthia Shishu Tirtha - Public Website Environment Configuration Template
# -----------------------------------------------------------------------------

# Supabase Connectivity (Client-Side & Server-Side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Canonical Public Website URL
NEXT_PUBLIC_SITE_URL=https://sainthiashishutirtha.in

# Server-Only Privileged Supabase Key (CRITICAL: Never expose to client-side bundles)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Content Revalidation Shared Secret (Used by CMS to revalidate public ISR cache)
REVALIDATION_SECRET=your-secure-random-revalidation-secret

# Hostinger Mail API Integration (CRITICAL: Server-only; do NOT use NEXT_PUBLIC_ prefix)
# Endpoint: POST https://api.mail.hostinger.com/api/v1/mailboxes/{HOSTINGER_MAILBOX_RESOURCE_ID}/send
HOSTINGER_MAIL_API_TOKEN=your-hostinger-mail-api-bearer-token
HOSTINGER_MAILBOX_RESOURCE_ID=your-hostinger-mailbox-resource-id

# Email Outbox Internal Dispatch Authorization Secret
# Used by the automated cron scheduler or webhook to invoke POST /api/internal/email-outbox/dispatch
# Header format: Authorization: Bearer <EMAIL_OUTBOX_DISPATCH_SECRET>
EMAIL_OUTBOX_DISPATCH_SECRET=your-secure-random-dispatch-secret
